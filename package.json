{
    "name": "questcord",
    "version": "1.1.4",
    "description": "A Vencord plugin that automates Discord Quests with smart real-time progress tracking",
    "author": "zpt0.dev",
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "https://github.com/zpt0/Questcord.git"
    },
    "keywords": [
        "vencord",
        "discord",
        "plugin",
        "quest",
        "automation",
        "auto-complete"
    ],
    "type": "module",
    "private": true,
    "overrides": {
        "@types/react": "$@types/react"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "@vencord/discord-types": "^1.0.2",
        "@vitest/coverage-v8": "^5.0.0",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.5",
        "typescript": "^5.3.0",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    }
}
